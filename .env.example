# Google Gemini API key (required for embeddings, query expansion, answer generation, and LLM-judge evaluation)
GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EXPANSION_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# Optional: App host & port
API_HOST=127.0.0.1
API_PORT=8000
