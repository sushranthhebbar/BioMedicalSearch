# Google Gemini API key (Free Tier works — used for query expansion, grounded answers, and RAGAS judge)
GEMINI_API_KEY=your_gemini_api_key_here

# Local CPU ONNX dense embedding model (via fastembed — $0 cost, no API key required)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Gemini LLM models (Free Tier friendly)
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EXPANSION_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# Optional rate-limit pacing for Gemini Free Tier (requests per minute; 0 to disable)
GEMINI_RPM_LIMIT=10

# Optional: App host & port
API_HOST=127.0.0.1
API_PORT=8000
